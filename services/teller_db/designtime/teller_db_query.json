  "getCustomerListData" : {
    "name" : "getCustomerListData",
    "description" : "Returns one row per customer with aggregated total balance (SUM), account count (COUNT), and account status summary (GROUP_CONCAT), joined with branch, address, and manager details.",
    "version" : "V2",
    "queryString" : "SELECT c.id AS customerid, c.customer_id AS customercode, c.first_name AS firstname, c.last_name AS lastname, c.phone AS phone, c.email AS email, COALESCE(SUM(b.current_balance), 0) AS totalbalance, br.name AS branchname, br_addr.city AS branchcity, COUNT(a.id) AS accountcount, m.name AS managername, m_br_addr.city AS managercity, GROUP_CONCAT(DISTINCT CONCAT(status_counts.cnt, ' ', status_counts.status) ORDER BY status_counts.status SEPARATOR ', ') AS accountstatussummary FROM customer c LEFT JOIN account a ON a.customer_id = c.customer_id LEFT JOIN balance b ON b.account_number = a.account_number LEFT JOIN branch br ON br.id = a.branch_id LEFT JOIN address br_addr ON br_addr.id = br.address_id LEFT JOIN manager m ON m.manager_id = a.manager_id LEFT JOIN branch m_br ON m_br.id = m.branch_id LEFT JOIN address m_br_addr ON m_br_addr.id = m_br.address_id LEFT JOIN (SELECT a2.customer_id, a2.status, COUNT(*) AS cnt FROM account a2 GROUP BY a2.customer_id, a2.status) status_counts ON status_counts.customer_id = c.customer_id GROUP BY c.id, c.customer_id, c.first_name, c.last_name, c.phone, c.email, br.name, br_addr.city, m.name, m_br_addr.city",
    "countQueryString" : "select count(*) from (SELECT c.id AS customerid, c.customer_id AS customercode, c.first_name AS firstname, c.last_name AS lastname, c.phone AS phone, c.email AS email, COALESCE(SUM(b.current_balance), 0) AS totalbalance, br.name AS branchname, br_addr.city AS branchcity, COUNT(a.id) AS accountcount, m.name AS managername, m_br_addr.city AS managercity, GROUP_CONCAT(DISTINCT CONCAT(status_counts.cnt, ' ', status_counts.status) ORDER BY status_counts.status SEPARATOR ', ') AS accountstatussummary FROM customer c LEFT JOIN account a ON a.customer_id = c.customer_id LEFT JOIN balance b ON b.account_number = a.account_number LEFT JOIN branch br ON br.id = a.branch_id LEFT JOIN address br_addr ON br_addr.id = br.address_id LEFT JOIN manager m ON m.manager_id = a.manager_id LEFT JOIN branch m_br ON m_br.id = m.branch_id LEFT JOIN address m_br_addr ON m_br_addr.id = m_br.address_id LEFT JOIN (SELECT a2.customer_id, a2.status, COUNT(*) AS cnt FROM account a2 GROUP BY a2.customer_id, a2.status) status_counts ON status_counts.customer_id = c.customer_id GROUP BY c.id, c.customer_id, c.first_name, c.last_name, c.phone, c.email, br.name, br_addr.city, m.name, m_br_addr.city) wmTempTable",
